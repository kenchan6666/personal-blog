# Copy to deployment/.env on the VM. Never commit .env.
# After Let's Encrypt succeeds, use https:// for PUBLIC_ORIGIN and GitHub URLs.

PUBLIC_ORIGIN=https://kenchan0522.blog
CORS_ORIGINS=https://kenchan0522.blog,http://kenchan0522.blog,http://127.0.0.1

OWNER_EMAIL=ynchanhk@gmail.com
TLS_EMAIL=ynchanhk@gmail.com
OTP_RATE_LIMIT=50
OTP_TTL_SECONDS=300
OTP_RATE_WINDOW_SECONDS=900
SESSION_TTL_SECONDS=604800

# console = OTP in API logs
# smtp    = Gmail SMTP (often fails from this VM; OTP still prints on failure)
# resend  = HTTPS via Resend (works on GCP). Sign up at https://resend.com
#           Verify kenchan0522.blog, then set RESEND_API_KEY and SMTP_FROM.
MAIL_BACKEND=console
RESEND_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ynchanhk@gmail.com
SMTP_PASSWORD=
SMTP_FROM=ken@kenchan0522.blog

# Optional until SourceRepo. GitHub OAuth callback must match PUBLIC_ORIGIN.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=https://kenchan0522.blog/api/auth/github/callback
GITHUB_OAUTH_SUCCESS_URL=https://kenchan0522.blog/zh-Hant/admin

# Compose overwrites these with in-stack hosts. Keep as documentation / fallback.
MONGO_URI=mongodb://mongo:27017
MONGO_DB=portfolio
REDIS_URL=redis://redis:6379/0
AVATAR_DIR=/data/avatars

# Leave empty. Browser talks to /api on the same origin via nginx.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_SITE_URL=https://kenchan0522.blog

# Portfolio Agent (server-side only; never expose these to NEXT_PUBLIC_*).
# Generate both tokens independently, e.g. `openssl rand -hex 32`.
UNI_API_KEY=
UNI_API_BASE=https://api.uniapi.io
VIOLA_AGENT_MODEL=gemini-2.5-flash
AGENT_INTERNAL_TOKEN=
AGENT_SERVICE_TOKEN=
AGENT_API_URL=http://agent:8900
AGENT_UPLOAD_MAX_BYTES=10485760

# "About Me" RAG. Qdrant runs inside docker-compose; embeddings use UniAPI.
# If your UniAPI account exposes a different embedding model, change this slug.
AGENT_EMBEDDING_MODEL=gemini-embedding-001
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=portfolio_about_me

# Public read-only portfolio guide. It can only see Published content and
# public repository READMEs; rate limits are enforced in Redis before UniAPI.
PUBLIC_AGENT_ENABLED=true
PUBLIC_AGENT_MODEL=gemini-2.5-flash
PUBLIC_AGENT_MAX_TOKENS=350
PUBLIC_AGENT_RATE_MINUTE=4
PUBLIC_AGENT_RATE_HOUR=20
PUBLIC_AGENT_RATE_DAY=40
PUBLIC_AGENT_DAILY_BUDGET=500
