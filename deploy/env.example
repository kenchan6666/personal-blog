# Copy to deploy/.env (never commit deploy/.env).
# Public hostname used in GitHub OAuth redirects, e.g. http://YOUR_VM_IP or https://example.com
PUBLIC_ORIGIN=http://localhost

OWNER_EMAIL=ynchanhk@gmail.com

# console = OTP printed in `docker compose logs api`
# smtp    = Gmail (or other) App Password
MAIL_BACKEND=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Same-origin via nginx is enough for the browser; keep localhost for mixed local testing.
CORS_ORIGINS=http://localhost,http://127.0.0.1

# GitHub OAuth App (optional until SourceRepo is used in prod)
# Homepage: ${PUBLIC_ORIGIN}
# Authorization callback: ${PUBLIC_ORIGIN}/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost/api/auth/github/callback
GITHUB_OAUTH_SUCCESS_URL=http://localhost/zh-Hant/admin
