# Leave MONGO_URI empty to persist Site/Project/Article/Journal/Comment as JSON
# under LOCAL_DATA_DIR. Set a URI (and run Mongo) to use MongoDB instead.
MONGO_URI=
MONGO_DB=portfolio
LOCAL_DATA_DIR=data/local
REDIS_URL=redis://127.0.0.1:6380/0
OWNER_EMAIL=ynchanhk@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ynchanhk@gmail.com
SMTP_PASSWORD=
SMTP_FROM=ken@kenchan0522.blog
# console | smtp | resend
# resend = HTTPS (works on GCP). Set RESEND_API_KEY after verifying the domain.
MAIL_BACKEND=console
RESEND_API_KEY=
OTP_RATE_LIMIT=50
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
AVATAR_DIR=data/avatars
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://127.0.0.1:8000/api/auth/github/callback
GITHUB_OAUTH_SUCCESS_URL=http://localhost:3000/zh-Hant/admin

# Optional local Portfolio Agent proxy. Production values live in deployment/.env.
AGENT_API_URL=http://127.0.0.1:8900
AGENT_INTERNAL_TOKEN=
AGENT_SERVICE_TOKEN=
AGENT_UPLOAD_MAX_BYTES=10485760

# --- VM / production: copy to deployment/.env (not this file) ---
# PUBLIC_ORIGIN=http://203.0.113.10
# CORS_ORIGINS=http://203.0.113.10,http://127.0.0.1
# GITHUB_OAUTH_CALLBACK_URL=http://203.0.113.10/api/auth/github/callback
# GITHUB_OAUTH_SUCCESS_URL=http://203.0.113.10/zh-Hant/admin
